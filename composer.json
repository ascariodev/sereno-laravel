{
    "name": "ascario/sereno-laravel",
    "description": "Sends Laravel logs to Sereno project channels.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "Ascario\\Sereno\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ascario\\Sereno\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ascario\\Sereno\\SerenoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
